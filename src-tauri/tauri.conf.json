{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wraith",
  "mainBinaryName": "wraith-ui",
  "version": "0.0.13",
  "identifier": "dev.ratatoskr.wraith",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Wraith",
        "width": 1200,
        "height": 760,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "copyright": "Copyright Asgard",
    "publisher": "Asgard",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["wraith"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxQzc2QzEzODA0QkFCMTEKUldRUnEwdUFFMnpIOGU0Sy9OTjlDNDFyUm10OGxrMk5qMGRVK1IyaDQ2YndENU5pNEgrNkozd2YK",
      "endpoints": ["https://dist.wraith.io/launcher/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
